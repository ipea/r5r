<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Define LOG_PATH using DATA_PATH with fallback to current dir -->
    <property name="LOG_PATH" value="${LOG_PATH:-./r5r-log.log}" />

    <appender name="RFILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger - %msg%n</pattern>
        </encoder>
        <append>false</append>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight([%-5level]) %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- progress counters go to the log file only: R prints the progress itself -->
    <logger name="org.ipea.r5r.Process.R5Process" additivity="false">
        <appender-ref ref="RFILE"/>
    </logger>
    <logger name="org.ipea.r5r.Process.R5DataFrameProcess" additivity="false">
        <appender-ref ref="RFILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="RFILE"/>
    </root>

</configuration>
